<section>
  <h2>Edit CD</h2>
  <form method="post" action="/cds/<%= cd._id %>?_method=PUT" class="form-grid" style="max-width:520px;">
    <div>
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= cd.title %>" required>
    </div>
    <div>
      <label for="artist">Artist</label>
      <input type="text" id="artist" name="artist" value="<%= cd.artist %>" required>
    </div>
    <div>
      <label for="genre">Genre</label>
      <input type="text" id="genre" name="genre" value="<%= cd.genre %>" required>
    </div>
    <div>
      <label for="year">Release Year</label>
      <input type="number" id="year" name="year" value="<%= cd.year %>" min="1900" max="2100" required>
    </div>
    <div>
      <label for="totalCopies">Total Copies</label>
      <input type="number" id="totalCopies" name="totalCopies" value="<%= cd.totalCopies %>" min="1" required>
    </div>
    <div>
      <label for="availableCopies">Available Copies</label>
      <input type="number" id="availableCopies" name="availableCopies" value="<%= cd.availableCopies %>" min="0" required>
    </div>
    <button type="submit" class="button">Update CD</button>
    <a href="/cds/<%= cd._id %>" class="button secondary">Back</a>
  </form>
</section>
